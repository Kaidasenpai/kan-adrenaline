{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "adrenaline-tasks",
  "main": "worker.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "63b73ae749959921a3007679aca62f7d",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "task.adrenaent.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": false,
  },
  "vars": {
    "ADRENALINE_WORKERS": "true",
    "NEXT_PUBLIC_BASE_URL": "https://task.adrenaent.com",
    "NEXT_PUBLIC_ALLOW_CREDENTIALS": "true",
    "NEXT_PUBLIC_DISABLE_SIGN_UP": "true",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://task.adrenaent.com",
    "LOG_LEVEL": "warn",
    "NEXT_PUBLIC_DISABLE_EMAIL": "true",
  },
  "alias": {
    "open-next-worker": "./.open-next/worker.js",
  },
}
